{
  "cleanUrls": true,
  "installCommand": "export npm_config_cache=\"${npm_config_cache:-${npm_config_cache_dir:-$HOME/.npm}}\"; unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR; npm install",
  "buildCommand": "export npm_config_cache=\"${npm_config_cache:-${npm_config_cache_dir:-$HOME/.npm}}\"; unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR; npm run build",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/Amr%20Atef%20Imam.pdf",
      "destination": "/api/cv-pdf"
    },
    {
      "source": "/Amr Atef Imam.pdf",
      "destination": "/api/cv-pdf"
    },
    {
      "source": "/Amr_Kandel_Resume_ATS.pdf",
      "destination": "/api/cv-pdf"
    }
  ],
  "headers": [
    {
      "source": "/(index\\.html|admin\\.html|admin|sw-admin\\.js|version\\.json|admin-manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}